{% extends 'base.html.twig' %}

{% block title %}Student{% endblock %}

{% block body %}
    <h1>Profs de {{ app.user.name }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th scope="col">Nom</th>
            <th scope="col">Prenom</th>
        </tr>
        </thead>
        <tbody>
        {% for gr in student.grades %}
            <tr>
                <td>{{ gr.professor }}</td>
            </tr>
        {% endfor %}


        <tr>
            <td>{{ "Moyenne" }}</td>
        </tr>
        </tbody>
    </table>

{% endblock %}
